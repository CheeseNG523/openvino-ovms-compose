# =============================================================================
# openvino-ovms-compose — copy to .env and edit. Do NOT commit .env.
#   cp .env.example .env
# =============================================================================

# --- Model (HF OpenVINO org) ---
# Default demo: small INT4 instruct. Prefer *-int4-cw-ov for NPU when listed on HF.
SOURCE_MODEL=OpenVINO/Qwen2.5-1.5B-Instruct-int4-ov

# Optional Hugging Face token (gated models). Leave empty for public OpenVINO org.
HF_TOKEN=

# --- Device ---
# Runtime device is chosen by Compose PROFILE (not this alone):
#   docker compose --profile cpu up    → CPU (hardcoded in service)
#   docker compose --profile gpu up    → GPU + /dev/dri
#   docker compose --profile npu up    → NPU + /dev/accel (Stateful; CB flags no-op)
# Enable only ONE profile at a time (shared host ports → clash if two).
# This var is for documentation / scripts/pull-model.sh:
TARGET_DEVICE=CPU

# Host identity for volume / device perms (uncomment user: in compose if needed)
HOST_UID=1000
HOST_GID=1000
# Render group GID on host: `getent group render | cut -d: -f3` (often 109 or 110)
RENDER_GID=109

# --- Ports (REST primary; gRPC also published) ---
REST_PORT=8000
GRPC_PORT=9000

# --- Auth ---
# Empty (default) = open / no Authorization required (copy-paste DX).
# Non-empty = entrypoint writes /tmp/ovms_api_key and passes --api_key_file;
#   OVMS also honors env API_KEY natively if --api_key_file is omitted.
# Clients: Authorization: Bearer <API_KEY>  (OpenAI client api_key=)
# Healthcheck also sends Bearer when this is non-empty.
# vLLM analogue: --api-key
API_KEY=

# =============================================================================
# GenAI / Continuous Batching knobs (CPU + GPU profiles)
# Prefer KV/prefix/u8; CB vs NPU Stateful; INT4/MoE friendly.
# AVOID tensor parallel — no TP (OVMS GH #3816).
# =============================================================================

# Approx vLLM --gpu-memory-utilization / KV footprint (OVMS cache_size, GB-ish)
CACHE_SIZE=10

# vLLM --max-num-seqs
MAX_NUM_SEQS=8

# vLLM --max-num-batched-tokens
MAX_NUM_BATCHED_TOKENS=8192

# KV quant; u8 preferred when supported. Approx vLLM KV quantization.
KV_CACHE_PRECISION=u8

# Prefix caching (vLLM --enable-prefix-caching).
# When =1, entrypoint appends --enable_prefix_caching for cpu/gpu only.
# NPU Stateful: no-op (entrypoint never injects for OVMS_DEVICE=NPU).
ENABLE_PREFIX_CACHING=0

# Dynamic split fuse (OVMS GenAI scheduler). Default off.
# When =1, entrypoint appends --dynamic_split_fuse for cpu/gpu only.
# NPU Stateful: NO-OP (entrypoint never injects for OVMS_DEVICE=NPU).
DYNAMIC_SPLIT_FUSE=0

# Idle unload timeout in seconds (OVMS-specific; OK on all devices including NPU).
# Leave empty / commented = unset (entrypoint omits the flag).
# Set to 0 or a positive integer to append --idle_unload_timeout_seconds <value>.
# IDLE_UNLOAD_TIMEOUT_SECONDS=

# --- NPU-only (Stateful pipeline) ---
# CB flags above are NO-OPS on NPU Stateful: cache_size, DSF,
# max_num_batched_tokens, max_num_seqs, prefix caching, eviction, sparse attn.
# Prefer INT4 --sym --ratio 1.0 --group-size -1 exports; *-int4-cw-ov when listed.
MAX_PROMPT_LEN=2048

# =============================================================================
# Quick OVMS ↔ vLLM map (full table: docs/VLLM_FLAG_MAP.md)
# =============================================================================
# REST_PORT / --rest_port              ↔ serve port                    (Good)
# API_KEY / --api_key_file             ↔ --api-key                     (Good)
# SOURCE_MODEL                         ↔ --model                       (Good)
# --max_num_seqs                       ↔ --max-num-seqs                (Good)
# --max_num_batched_tokens             ↔ --max-num-batched-tokens      (Good)
# --enable_prefix_caching              ↔ --enable-prefix-caching       (Good)
# OpenAI base_url .../v1               ↔ same                          (Good)
# --cache_size / KV knobs              ↔ --gpu-memory-utilization / KV (Thin)
# (n/a — NO TP in this design)         ↔ --tensor-parallel-size        (AVOID #3816)
# export-time precision / OV IR        ↔ --dtype                       (Approx)
# Continuous batching CPU/GPU          ↔ CB                            (Good; NPU Stateful queued)
# --max_prompt_len (NPU)               ↔ related to max model len      (Thin)
# --pipeline_type Stateful (NPU)       ↔ (no direct)                   (NPU-specific)
# --idle_unload_timeout_seconds        ↔ (idle GC)                     (OVMS-specific)
# --kv_cache_precision u8              ↔ KV quant                      (Approx)
# --dynamic_split_fuse                 ↔ (scheduler)                   (OVMS GenAI)
# --target_device                      ↔ device placement              (OVMS-specific)
